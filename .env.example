# ===== utf8-search 配置示例（复制为 .env 后修改）=====

# SearXNG 服务地址：
#   本机 Docker 方式（docker compose up searxng）填 http://127.0.0.1:8888
#   容器内互访（本服务也在 compose 里）填 http://searxng:8080
UTF8SEARCH_SEARXNG_URL=http://127.0.0.1:8888

# SearXNG 用哪份配置（对应 searxng/ 目录下的文件，由 docker compose 挂载）：
#   ./searxng/settings.yml        云端默认：直连出网，无需代理
#   ./searxng/settings.local.yml  本机开发：额外给 SearXNG 加上海外代理
# SearXNG 的出口只认 settings.yml 里的 outgoing.proxies，不读 HTTP_PROXY 环境变量。
# 中国大陆网络直连时 google.com / duckduckgo.com 会 ConnectTimeout，必须用本地版；
# 海外服务器直连可达，保持默认即可。
SEARXNG_SETTINGS_FILE=./searxng/settings.yml

# 监听地址（serve 模式）
UTF8SEARCH_HOST=0.0.0.0
UTF8SEARCH_PORT=8000

# 访问鉴权：逗号分隔的 API Key 列表。留空则关闭鉴权（仅建议本机使用）
UTF8SEARCH_API_KEYS=
# 每个 Key 每分钟最大请求数
UTF8SEARCH_RATE_LIMIT_RPM=60

# MCP Streamable HTTP 允许的 Host（部署到公网域名时必须填写，否则返回 421）
UTF8SEARCH_MCP_ALLOWED_HOSTS=

# 超时与并发
UTF8SEARCH_REQUEST_TIMEOUT=8
UTF8SEARCH_FETCH_TIMEOUT=4.0
# 单页总时长上限（含下载+解析，超过即放弃该页）
UTF8SEARCH_PAGE_TOTAL_TIMEOUT=5.0
# 抓取阶段总预算：advanced 追求速度，deep 追求覆盖
UTF8SEARCH_ADVANCED_BUDGET=5.0
UTF8SEARCH_DEEP_BUDGET=12
# 批量抽取接口（/extract、web_fetch）的总时间预算：调用方已指定 URL，给更宽松的预算
UTF8SEARCH_EXTRACT_BUDGET=10
# deep 模式的单页时长上限（deep 以覆盖为先，可放宽）
UTF8SEARCH_DEEP_PAGE_TIMEOUT=8
# deep 模式的单页下载上限
UTF8SEARCH_DEEP_DOWNLOAD_TIMEOUT=5
# 正文解析线程池大小
UTF8SEARCH_EXTRACT_WORKERS=8
UTF8SEARCH_MAX_FETCH_CONCURRENCY=24
# 深度模式：成功读到该比例的目标页面即提前返回（越大越完整、越慢）
UTF8SEARCH_FETCH_EARLY_STOP_RATIO=0.5
UTF8SEARCH_FETCH_MIN_PAGES=3
# deep 模式的提前返回比例：deep 以覆盖为先，读过更多页面才停（对标「读几十个网页」）
UTF8SEARCH_DEEP_EARLY_STOP_RATIO=0.8

# 各深度模式抓取的页面数
UTF8SEARCH_ADVANCED_PAGES=6
UTF8SEARCH_DEEP_PAGES=24

# 单页返回给 LLM 的正文字符上限（deep/advanced 模式）
UTF8SEARCH_PAGE_MAX_CHARS=3000
# include_raw_content=true 时单页返回上限
UTF8SEARCH_RAW_CONTENT_MAX_CHARS=20000

# 上游并发闸门（M5 并发保护）：限制「同时打到 SearXNG 的聚合请求数」。
# 背景：实测并发 1-3 时 P50≈1.3s，并发 10 冷查询劣化到 ~12s；直连探测显示上游聚合吞吐仅
# 1.3-2.0 req/s —— 瓶颈在上游聚合。没有闸门时 10 个请求会同时压垮上游，全体一起慢。
# 目标：宁可快速失败，不要一起慢。超出闸门的请求排队；队列满或等待超限立即返回 429。
#   MAX_CONCURRENCY：同时打到上游的请求上限（0 = 关闭闸门，不推荐）
#   QUEUE_LIMIT    ：最多允许多少请求排队（队列满立即 429）
#   MAX_WAIT       ：排队等待上限（秒），超过立即 429；默认≈单次上游预算
# 注意：闸门是单进程的；用多 worker 起服务时需按 worker 数分摊（每 worker 各有一份闸门）。
UTF8SEARCH_UPSTREAM_MAX_CONCURRENCY=3
UTF8SEARCH_UPSTREAM_QUEUE_LIMIT=6
UTF8SEARCH_UPSTREAM_MAX_WAIT=2.5
# 是否暴露 /metrics（Prometheus 文本格式）：暴露闸门等待数、排队时长、被拒计数、上游延迟直方图。
# 沿用 REST 鉴权（开启鉴权时需带 Key）；置 false 可整体关闭该端点。
UTF8SEARCH_METRICS_ENABLED=true

# 缓存 TTL（秒）
UTF8SEARCH_CACHE_QUERY_TTL=600
UTF8SEARCH_CACHE_PAGE_TTL=21600
UTF8SEARCH_CACHE_RESULT_TTL=300
UTF8SEARCH_CACHE_PATH=data/cache.db

# 搜索语言与安全策略：all 表示不限制语言（中英兼顾）
UTF8SEARCH_LANGUAGE=all
UTF8SEARCH_SAFE_SEARCH=0
# SearXNG 聚合搜索时间上限（秒）：到点返回已有结果，避免个别引擎拖慢整体
UTF8SEARCH_SEARCH_TIMEOUT_LIMIT=2.5

# 默认启用的搜索引擎（传给 SearXNG 的 engines 参数，逗号分隔；留空表示用 SearXNG 默认配置）
# 实测（2026-09-24 复测，8 条中英新闻/通用查询交叉验证）：
#   稳定：resulthunter / yandex / naver / privacywall / google / zapmeta / yahoo / fynd
#   机会型（间歇被限流，失败极快）：reloado / yep / brave / quark
#   注意：这些「机会型」引擎不必手工删除 —— M5-5.1 的引擎健康度自适应会按失败原因
#   把它们临时冷却、到期自动恢复，删掉反而会丢掉它们能正常出结果的那段时间。
#   已剔除：sogou（sogou.py:56 AttributeError 恒崩溃，8/8 查询 0 条结果）
UTF8SEARCH_DEFAULT_ENGINES=resulthunter,yandex,naver,privacywall,google,zapmeta,yahoo,fynd,reloado,yep,brave,quark
# 注意：本服务给了 engines 就不再传 categories。SearXNG 里两者是「叠加」关系
# （webadapter.parse_generic），同时传会让 engines 列表失去约束力，退回该类目全部引擎。

# ===== 引擎健康度自适应（M5-5.1）=====
# 实测结论（2026-09-24）：SearXNG 对处于惩罚期的引擎是「快速失败」（0.03-0.19s、根本不发上游请求），
# 因此剔除挂掉的引擎并不省延迟（A/B 实测：全 12 引擎 P50 0.99s vs 只留 7 个「当时健康」的 0.98s）；
# 而且引擎健康度是分钟级漂移的（`google` 上一轮 5/5 被 CAPTCHA，这一轮 100% 正常），静态名单必然过期。
# 所以这里做的是「按失败原因分级冷却 + 到期自动恢复」的租约机制，而不是一次性剔除：
# 冷却时长到期后引擎会自动回到候选集，任一次成功即清零失败计数。
UTF8SEARCH_ENGINE_HEALTH_ENABLED=true
# 候选里至少保留的可用引擎数：不足时按「最早解冻优先」补入冷却中的引擎，防止引擎集合萎缩
UTF8SEARCH_ENGINE_HEALTH_MIN_ACTIVE=6
# 每次查询额外带入的冷却中引擎数（0 = 只靠冷却到期自动恢复，零额外浪费）
UTF8SEARCH_ENGINE_HEALTH_PROBE_SLOTS=0
# 各失败原因对应的冷却时长（秒）：CAPTCHA/access denied 是硬封锁，退避最久；限流/超时较短。
# 连续失败会指数退避（2 倍递增）并封顶在 COOLDOWN_MAX。
UTF8SEARCH_ENGINE_HEALTH_COOLDOWN_CAPTCHA=1800
UTF8SEARCH_ENGINE_HEALTH_COOLDOWN_DENIED=900
UTF8SEARCH_ENGINE_HEALTH_COOLDOWN_RATE_LIMIT=180
UTF8SEARCH_ENGINE_HEALTH_COOLDOWN_TIMEOUT=90
UTF8SEARCH_ENGINE_HEALTH_COOLDOWN_OTHER=120
UTF8SEARCH_ENGINE_HEALTH_COOLDOWN_MAX=3600

# 是否启用 Jina Reader（https://r.jina.ai/）作为正文抽取兜底（免费、免密钥）
UTF8SEARCH_ENABLE_JINA_FALLBACK=true
# 仅 deep 模式允许 Jina 兜底（advanced 走纯本地抓取，保证速度）
UTF8SEARCH_JINA_FALLBACK_DEPTHS=deep
UTF8SEARCH_JINA_TIMEOUT=3

# ===== 时效性（topic=news，M5-5.2）=====
# 新闻类目引擎（topic=news 时传给 SearXNG 的 engines）。2026-09-24 逐引擎隔离实测：
#   duckduckgo news  日期覆盖 100%、英文时效最好，但纯中文查询会返回 0 条
#   sogou wechat     8/8 查询各 10 条且 100% 带日期，补中文盲区，0.4s
#   google news      中文覆盖最全但不给发布日期，靠 URL/页面回补日期
# 已剔除：bing news（0 条）/ reuters（7 日内 0 条）/ brave.news（被限流）/ wikinews（停在 2024 年）
UTF8SEARCH_NEWS_ENGINES=duckduckgo news,sogou wechat,google news
# 结果的「新鲜」排序窗口（天）：未显式指定 time_range 时生效
UTF8SEARCH_NEWS_FRESH_DAYS=7
# 缺失发布日期时，先用 URL 里内嵌的日期补全（零网络开销），再抓页面用 htmldate 推断
UTF8SEARCH_NEWS_DATE_BACKFILL=true
# 抓页面回补日期：最多抓多少页、总预算多少秒
UTF8SEARCH_NEWS_DATE_PAGES=16
UTF8SEARCH_NEWS_DATE_BUDGET=4.0
# 新闻主题向上游要的候选条数：太少会没得挑，时效排序与过期过滤都会失效
UTF8SEARCH_NEWS_CANDIDATE_POOL=30
# 新闻主题额外补一次通用引擎（新闻源对中文长尾覆盖差，用通用结果兜底）
UTF8SEARCH_NEWS_INCLUDE_GENERAL=true
# 是否把 time_range 透传给上游：免费新闻引擎对此支持极差，实测带 time_range 一律返回 0 条，默认不透传
UTF8SEARCH_NEWS_PASS_TIME_RANGE=false
# 是否丢弃「已知过期」的新闻结果（仅在剩余结果已够 max_results 时生效）
UTF8SEARCH_NEWS_DROP_STALE=true

# ===== 查询质量与多样性（M5-5.3）=====
# 通用主题向上游索取的候选条数。必须是「候选池」而不是 top-N：SearXNG 本来就把整批结果
# 一次返回给本地，多留候选不增加任何网络开销；而候选数等于结果数时，质量过滤会因为
# 「不足 max_results」被全部补回，等于失效（2-9 抽检的聚合页/首页就是这样漏进来的）。
UTF8SEARCH_RANK_CANDIDATE_POOL=24
# 同一可注册域在最终结果里最多保留几条（0=不限）。实测 bilibili 单查询会灌 20 条同站视频
UTF8SEARCH_RANK_MAX_PER_HOST=2
# 查询词覆盖率下限：候选充足时剔除覆盖率低于该值的结果（0=关闭）
# 覆盖率 = 查询词（中文按二元组分词）在「标题+正文」里的命中比例
UTF8SEARCH_RANK_MIN_QUERY_COVERAGE=0.34
# 候选充足时剔除站点首页/栏目页/标签页这类聚合页（正文只是导航，对 LLM 无价值）
# 注意：新闻主题（topic=news）不套用此项与覆盖率下限 —— 会把「当天更新的日报页」
# 连同日期一起剔除，实测时效性 39/40 → 32/40（见 docs/reports/m5-5.3-verification-20260924.md）
UTF8SEARCH_RANK_DROP_AGGREGATOR_PAGES=true
# 查询含中文时，剔除标题为纯西里尔/阿拉伯/韩文等非中文/非英文脚本的结果（英文结果始终保留）
UTF8SEARCH_RANK_DROP_SCRIPT_MISMATCH=true
# 通用主题命中「最新/最近/latest/今日」这类时间词时，按新鲜度分层重排。
# 只用零网络开销的日期线索（URL 内嵌日期 + 标题里的跨年年份），不抓页面、不丢弃无日期结果
UTF8SEARCH_GENERAL_RECENCY_INTENT=true

# ===== 安全（SSRF 防护）=====
# 是否禁止抓取内网与保留地址。公网部署务必保持 true；
# 仅在「确实需要抓内网 wiki/文档」的内网自用场景才显式设为 false。
UTF8SEARCH_BLOCK_PRIVATE_HOSTS=true
# 抓取时允许的最大重定向次数，每一跳都会重新做一次安全校验（防 302 绕过）
UTF8SEARCH_MAX_REDIRECTS=5

# ===== 代理 =====
# Windows 上若开了系统代理（如 Clash 的 127.0.0.1:7897），httpx 会把访问本机 SearXNG
# 的请求也发给代理并收到 502（curl 会绕过 localhost，httpx 不会）。下列主机默认绕过
# 代理直连，一般无需修改。
UTF8SEARCH_TRUST_ENV=true
UTF8SEARCH_HTTP_PROXY=
UTF8SEARCH_BYPASS_PROXY_HOSTS=127.0.0.1,localhost,[::1],searxng
# 日志级别：DEBUG / INFO / WARNING
UTF8SEARCH_LOG_LEVEL=INFO
